# Secrets and local environments must never enter the build context.
.env
.env.*
!.env.example
.venv
venv

# Generated files and local tooling state.
__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache

# Repository metadata and editor artifacts do not belong in the image.
.git
.gitignore
.DS_Store
.idea
.vscode
